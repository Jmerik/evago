# EVAGO Environment Variables Template
# Copy this file to .env and fill in the actual values.

# ─── BACKEND API KEYS ───

# Duffel API Key for live flight data (required for production flight searches)
# Get a key from: https://duffel.com/
DUFFEL_API_KEY=

# Luma API Key for live event sync (optional, demo data is used if empty)
# Get a key from: https://luma.com/
LUMA_API_KEY=

# ─── VERCEL DEPLOYMENT ───

# Set to true when deployed to Vercel (used to restrict CORS origins and skip local server startup)
VERCEL=

# ─── SERVER ───

# Port for local development backend (defaults to 3001)
PORT=3001
