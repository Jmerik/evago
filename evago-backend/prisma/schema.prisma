generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model User {
  id          String      @id @default(uuid())
  lumaApiKey  String?     @unique
  createdAt   DateTime    @default(now())
  itineraries Itinerary[]
}

model Event {
  id                 String   @id // e.g. luma-evt-xxxxx or evago-evt-xxxxx
  source             String   // "luma" or "manual"
  sourceId           String
  name               String
  type               String   // "main_conference", "side_event"
  startAt            String
  endAt              String
  timezone           String
  address            String
  city               String?
  region             String?
  country            String?
  fullAddress        String?
  latitude           Float?
  longitude          Float?
  parentConferenceId String?  // ID of the main event if this is a side event
}

model Itinerary {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  eventId   String   // The main conference or side event ID
  status    String   // "going", "invited", etc
  createdAt DateTime @default(now())
}

model OrganizerCalendar {
  id          String   @id @default(uuid())
  name        String   // e.g. "TOKEN2049 Official"
  lumaApiKey  String   // The organizer's Luma calendar API key
  region      String   // e.g. "singapore", "bangkok", "dubai"
  city        String   // e.g. "Singapore", "Bangkok"
  country     String   // e.g. "Singapore", "Thailand"
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}
